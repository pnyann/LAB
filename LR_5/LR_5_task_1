import argparse
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import classification_report
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier, ExtraTreesClassifier

# Функція візуалізації класифікатора


def visualize_classifier(classifier, X, y, title):
    """
    Візуалізація меж класифікатора та точок даних
    """
# Визначаємо межі для сітки
    x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1
    y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1

    # Створюємо сітку
    step = 0.05
    xx, yy = np.meshgrid(np.arange(x_min, x_max, step),
                         np.arange(y_min, y_max, step))

    # Прогнозуємо для всіх точок сітки
    Z = classifier.predict(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)

    # Візуалізація
    plt.figure(figsize=(10, 8))
    plt.contourf(xx, yy, Z, alpha=0.3, cmap='viridis')

    # Кольори та маркери для різних класів
    colors = ['blue', 'green', 'red']
    markers = ['s', 'o', '^']
    class_names = ['Class-0', 'Class-1', 'Class-2']

    for i in range(3):
        mask = y == i
        if np.any(mask):
            plt.scatter(X[mask][:, 0], X[mask][:, 1],
                        s=75, facecolors='white', edgecolors=colors[i],
                        linewidth=1, marker=markers[i], label=class_names[i])

    plt.title(title, fontsize=14)
    plt.xlabel('Ознака 1', fontsize=12)
    plt.ylabel('Ознака 2', fontsize=12)
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

# Функція візуалізації тестових точок


def visualize_test_points(classifier, test_datapoints, title):
    """
    Візуалізація тестових точок даних на межах класифікатора
    """
    # Визначаємо межі для сітки
    x_min, x_max = test_datapoints[:, 0].min(
    ) - 2, test_datapoints[:, 0].max() + 2
    y_min, y_max = test_datapoints[:, 1].min(
    ) - 2, test_datapoints[:, 1].max() + 2

    # Створюємо сітку
    step = 0.05
    xx, yy = np.meshgrid(np.arange(x_min, x_max, step),
                         np.arange(y_min, y_max, step))

    # Прогнозуємо для всіх точок сітки
    Z = classifier.predict(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)

    # Візуалізація
    plt.figure(figsize=(10, 8))
    plt.contourf(xx, yy, Z, alpha=0.3, cmap='viridis')

    # Відображення тестових точок
    plt.scatter(test_datapoints[:, 0], test_datapoints[:, 1],
                s=200, c='black', marker='X', edgecolors='white',
                linewidth=2, label='Тестові точки')

    # Додаємо підписи до тестових точок
    for i, point in enumerate(test_datapoints):
        plt.annotate(f'({point[0]}, {point[1]})',
                     xy=(point[0], point[1]),
                     xytext=(10, 10),
                     textcoords='offset points',
                     fontsize=10, fontweight='bold')

    plt.title(title, fontsize=14)
    plt.xlabel('Ознака 1', fontsize=12)
    plt.ylabel('Ознака 2', fontsize=12)
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

# Парсер аргументів


def build_arg_parser():
    parser = argparse.ArgumentParser(
        description='Classify data using Ensemble Learning techniques')
    parser.add_argument('--classifier-type', dest='classifier_type', required=True,
                        choices=['rf', 'erf'], help="Type of classifier to use; can be either 'rf' or 'erf'")
    return parser


# Основна функція
if __name__ == '__main__':
    # Вилучення вхідних аргументів
    args = build_arg_parser().parse_args()
    classifier_type = args.classifier_type

# Завантаження вхідних даних
input_file = 'data_random_forests.txt'
data = np.loadtxt(input_file, delimiter=',')
X, y = data[:, :-1], data[:, -1]
y = y.astype(int)

print(f"Форма даних: {X.shape}")
print(f"Кількість класів: {len(np.unique(y))}")


# Розбиття вхідних даних на три класи

class_0 = np.array(X[y == 0])
class_1 = np.array(X[y == 1])
class_2 = np.array(X[y == 2])

# Візуалізація вхідних даних
plt.figure(figsize=(10, 8))
plt.scatter(class_0[:, 0], class_0[:, 1], s=75,
            facecolors='white', edgecolors='black',
            linewidth=1, marker='s', label='Class-0')
plt.scatter(class_1[:, 0], class_1[:, 1], s=75,
            facecolors='white', edgecolors='black',
            linewidth=1, marker='o', label='Class-1')
plt.scatter(class_2[:, 0], class_2[:, 1], s=75,
            facecolors='white', edgecolors='black',
            linewidth=1, marker='^', label='Class-2')
plt.title('Вхідні дані', fontsize=14)
plt.xlabel('Ознака 1')
plt.ylabel('Ознака 2')
plt.legend()
plt.grid(True, alpha=0.3)
plt.savefig('task1_input_data.png', dpi=150)
plt.show()

# Розбивка даних на навчальний та тестовий набори
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=5
)

print(f"\nРозмір навчального набору: {X_train.shape[0]}")
print(f"Розмір тестового набору: {X_test.shape[0]}")

# Параметри класифікатора

params = {'n_estimators': 100, 'max_depth': 4, 'random_state': 0}

# Створення класифікатора (залежно від типу)
if classifier_type == 'rf':
    classifier = RandomForestClassifier(**params)
    classifier_name = "Випадковий ліс (Random Forest)"
else:
    classifier = ExtraTreesClassifier(**params)
    classifier_name = "Гранично випадковий ліс (Extra Random Forest)"

print(f"\nВикористовується: {classifier_name}")

# Навчання та візуалізація класифікатора
classifier.fit(X_train, y_train)
visualize_classifier(classifier, X_train, y_train, 'Training dataset')

# Прогнозування та візуалізація на тестових даних
y_test_pred = classifier.predict(X_test)
visualize_classifier(classifier, X_test, y_test, 'Тестовий набір даних')

# Звіт про класифікацію
class_names = ['Class-0', 'Class-1', 'Class-2']

print("\n" + "#"*40)
print("\nClassifier performance on training dataset\n")
print(classification_report(y_train, classifier.predict(
    X_train), target_names=class_names))
print("#"*40 + "\n")

print("#"*40)
print("\nClassifier performance on test dataset\n")
print(classification_report(y_test, y_test_pred, target_names=class_names))
print("#"*40 + "\n")

# Оцінка рівнів довірливості
test_datapoints = np.array(
    [[5, 5], [3, 6], [6, 4], [7, 2], [4, 4], [5, 2]])

print("\n" + "="*50)
print("Confidence measure")
print("="*50)

for datapoint in test_datapoints:
    probabilities = classifier.predict_proba([datapoint])[0]
    predicted_class = 'Class-' + str(np.argmax(probabilities))
    print(f'\nDatapoint: {datapoint}')
    print(f'Predicted class: {predicted_class}')
    print(
        f'Probabilities: Class-0: {probabilities[0]:.4f}, Class-1: {probabilities[1]:.4f}, Class-2: {probabilities[2]:.4f}')


# Візуалізація тестових точок даних
visualize_test_points(classifier, test_datapoints, 'Тестові точки даних')
